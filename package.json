{
  "name": "quayside",
  "version": "1.1.1",
  "description": "Generic idempotency for Node.js — execute any operation exactly once per key, with pluggable storage, explicit concurrency semantics, and first-class observability.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./memory": {
      "import": {
        "types": "./dist/memory.d.ts",
        "default": "./dist/memory.mjs"
      },
      "require": {
        "types": "./dist/memory.d.cts",
        "default": "./dist/memory.cjs"
      }
    },
    "./redis": {
      "import": {
        "types": "./dist/redis.d.ts",
        "default": "./dist/redis.mjs"
      },
      "require": {
        "types": "./dist/redis.d.cts",
        "default": "./dist/redis.cjs"
      }
    },
    "./postgres": {
      "import": {
        "types": "./dist/postgres.d.ts",
        "default": "./dist/postgres.mjs"
      },
      "require": {
        "types": "./dist/postgres.d.cts",
        "default": "./dist/postgres.cjs"
      }
    },
    "./mysql": {
      "import": {
        "types": "./dist/mysql.d.ts",
        "default": "./dist/mysql.mjs"
      },
      "require": {
        "types": "./dist/mysql.d.cts",
        "default": "./dist/mysql.cjs"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/express.d.ts",
        "default": "./dist/express.mjs"
      },
      "require": {
        "types": "./dist/express.d.cts",
        "default": "./dist/express.cjs"
      }
    },
    "./fastify": {
      "import": {
        "types": "./dist/fastify.d.ts",
        "default": "./dist/fastify.mjs"
      },
      "require": {
        "types": "./dist/fastify.d.cts",
        "default": "./dist/fastify.cjs"
      }
    },
    "./hono": {
      "import": {
        "types": "./dist/hono.d.ts",
        "default": "./dist/hono.mjs"
      },
      "require": {
        "types": "./dist/hono.d.cts",
        "default": "./dist/hono.cjs"
      }
    },
    "./nestjs": {
      "import": {
        "types": "./dist/nestjs.d.ts",
        "default": "./dist/nestjs.mjs"
      },
      "require": {
        "types": "./dist/nestjs.d.cts",
        "default": "./dist/nestjs.cjs"
      }
    },
    "./prometheus": {
      "import": {
        "types": "./dist/prometheus.d.ts",
        "default": "./dist/prometheus.mjs"
      },
      "require": {
        "types": "./dist/prometheus.d.cts",
        "default": "./dist/prometheus.cjs"
      }
    },
    "./otel": {
      "import": {
        "types": "./dist/otel.d.ts",
        "default": "./dist/otel.mjs"
      },
      "require": {
        "types": "./dist/otel.d.cts",
        "default": "./dist/otel.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "memory": [
        "dist/memory.d.ts"
      ],
      "redis": [
        "dist/redis.d.ts"
      ],
      "postgres": [
        "dist/postgres.d.ts"
      ],
      "mysql": [
        "dist/mysql.d.ts"
      ],
      "express": [
        "dist/express.d.ts"
      ],
      "fastify": [
        "dist/fastify.d.ts"
      ],
      "hono": [
        "dist/hono.d.ts"
      ],
      "nestjs": [
        "dist/nestjs.d.ts"
      ],
      "prometheus": [
        "dist/prometheus.d.ts"
      ],
      "otel": [
        "dist/otel.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "hooks": "git config core.hooksPath .hooks",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepack": "npm run build",
    "test": "node --import tsx --test --test-timeout=10000 'tests/unit/**/*.test.ts'",
    "test:coverage": "node --import tsx --experimental-test-coverage --test-coverage-include='src/**' --test --test-timeout=10000 'tests/unit/**/*.test.ts'",
    "test:integration": "node --import tsx --test --test-timeout=120000 'tests/integration/**/*.test.ts'",
    "examples": "node --import tsx examples/nestjs.ts",
    "bench": "node --import tsx bench/run.ts",
    "test:mutation": "stryker run",
    "check:types": "tsc --noEmit",
    "check:types:next": "node node_modules/typescript7/bin/tsc --noEmit",
    "api:update": "npm run build && api-extractor run --local",
    "api:check": "npm run build && api-extractor run"
  },
  "keywords": [
    "idempotency",
    "idempotent",
    "exactly-once",
    "deduplication",
    "idempotency-key",
    "distributed-lock",
    "fencing-token",
    "redis",
    "postgres",
    "mysql"
  ],
  "author": "Pedro Rogério",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pinceladasdaweb/quayside.git"
  },
  "bugs": {
    "url": "https://github.com/pinceladasdaweb/quayside/issues"
  },
  "homepage": "https://github.com/pinceladasdaweb/quayside#readme",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10",
    "@opentelemetry/api": "^1.9.0",
    "prom-client": "^15.0.0",
    "rxjs": "^7"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "prom-client": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@microsoft/api-extractor": "^7.58.12",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/testing": "^11.2.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@pinceladasdaweb/redis": "^4.2.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/tap-runner": "^10.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "express": "^5.1.0",
    "fastify": "^5.12.1",
    "hono": "^4.13.3",
    "ioredis": "^6.0.0",
    "lint-staged": "^17.2.0",
    "mysql2": "^3.15.3",
    "neostandard": "^0.13.0",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rollup": "^4.62.2",
    "rollup-plugin-dts": "^6.4.1",
    "rxjs": "^7.8.2",
    "testcontainers": "^12.1.0",
    "tslib": "^2.8.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "typescript7": "npm:typescript@^7.0.2"
  },
  "overrides": {
    "typed-rest-client": {
      "qs": "^6.15.3"
    }
  },
  "lint-staged": {
    "src/**/*.ts": "eslint",
    "tests/**/*.ts": "eslint"
  },
  "sideEffects": false
}
